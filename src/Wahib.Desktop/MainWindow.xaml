<Window x:Class="Wahib.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الوهيب ERP | AL-WAHIB" Width="1330" Height="830" MinWidth="1030" MinHeight="620"
        FlowDirection="RightToLeft" Background="{StaticResource Backdrop}" FontFamily="Segoe UI" FontSize="14">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#153E63">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="12,24,12,16">
          <TextBlock Text="الوهيب" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
          <TextBlock Text="AL-WAHIB ERP" Foreground="#9BCBE9" FontSize="13" HorizontalAlignment="Center"/>
          <TextBlock x:Name="CompanyLabel" Foreground="#DAEDFF" TextWrapping="Wrap" Margin="10,16,10,2" TextAlignment="Center"/>
        </StackPanel>
        <StackPanel x:Name="NavPanel" DockPanel.Dock="Top" Margin="8,10"/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="21">
      <Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
      <Border Background="White" CornerRadius="11" Padding="18,10" Grid.Row="0">
        <DockPanel>
          <TextBlock x:Name="CurrentUser" DockPanel.Dock="Left" Foreground="#5C748C" VerticalAlignment="Center"/>
          <TextBlock x:Name="PageTitle" Text="نظام الوهيب" FontSize="24" FontWeight="SemiBold" Foreground="#173C60" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <Border Grid.Row="1" Background="White" CornerRadius="10" Margin="0,15,0,9" Padding="13">
        <ContentControl x:Name="Workspace"/>
      </Border>
      <TextBlock Grid.Row="2" x:Name="Footer" Foreground="#5A7083" VerticalAlignment="Center" Text="Offline • Windows • Local SQLite • Single workstation"/>
    </Grid>
  </Grid>
</Window>
